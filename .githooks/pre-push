#!/bin/sh
set -eu

repo=$(git rev-parse --show-toplevel)

while read -r local_ref local_oid remote_ref remote_oid; do
  # A deleted ref has no source tree to check.
  case "$local_oid" in
    *[!0]*) ;;
    *) continue ;;
  esac

  snapshot=$(mktemp -d "${TMPDIR:-/tmp}/ost-pre-push.XXXXXX")
  trap 'rm -rf "$snapshot"' EXIT
  git -C "$repo" archive --format=tar "$local_oid" -o "$snapshot/source.tar"
  tar -xf "$snapshot/source.tar" -C "$snapshot"
  rm "$snapshot/source.tar"

  printf 'Vérification du format de %s…\n' "$local_ref"
  if ! "$repo/scripts/check-format.sh" "$snapshot"; then
    echo 'Push annulé : formatez, puis commitez les corrections avant de réessayer.' >&2
    exit 1
  fi

  rm -rf "$snapshot"
  trap - EXIT
done
